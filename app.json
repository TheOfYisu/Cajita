{
  "expo": {
    "name": "Cajita",
    "slug": "cajita",
    "version": "1.0.11",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "cajita",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#123F36"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cajita.app",
      "buildNumber": "4",
      "appleTeamId": "254TTZ2VC5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Cajita usa Face ID únicamente en tu dispositivo para desbloquear la app y proteger tus datos financieros locales.",
        "NSUbiquitousContainers": {
          "iCloud.com.cajita.app": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerSupportedFolderLevels": "Any",
            "NSUbiquitousContainerName": "Cajita"
          }
        },
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "com.cajita.app.new-expense",
            "UIApplicationShortcutItemTitle": "Registrar gasto",
            "UIApplicationShortcutItemSubtitle": "Anotar un gasto rápido",
            "UIApplicationShortcutItemIconSymbolName": "arrow.down.circle.fill"
          },
          {
            "UIApplicationShortcutItemType": "com.cajita.app.new-income",
            "UIApplicationShortcutItemTitle": "Registrar ingreso",
            "UIApplicationShortcutItemSubtitle": "Anotar un ingreso",
            "UIApplicationShortcutItemIconSymbolName": "arrow.up.circle.fill"
          },
          {
            "UIApplicationShortcutItemType": "com.cajita.app.new-transfer",
            "UIApplicationShortcutItemTitle": "Transferencia",
            "UIApplicationShortcutItemSubtitle": "Mover dinero entre cuentas",
            "UIApplicationShortcutItemIconSymbolName": "arrow.left.arrow.right.circle.fill"
          },
          {
            "UIApplicationShortcutItemType": "com.cajita.app.cash",
            "UIApplicationShortcutItemTitle": "Mi efectivo",
            "UIApplicationShortcutItemSubtitle": "Billetes y monedas",
            "UIApplicationShortcutItemIconSymbolName": "banknote.fill"
          }
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      },
      "usesIcloudStorage": true
    },
    "android": {
      "package": "com.cajita.app",
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#123F36",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withCajitaEntitlements",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Cajita usa Face ID únicamente en tu dispositivo para desbloquear la app y proteger tus datos financieros locales."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cajita usa Face ID únicamente en tu dispositivo para desbloquear la app y proteger tus datos financieros locales."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#278A68"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
